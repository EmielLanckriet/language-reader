#!/data/data/com.termux/files/usr/bin/sh
# Start the reader service as a Termux task; ~/.bashrc runs this when Termux is opened (issue #17).
# Started in the terminal session itself, the service lasted only as long as that session: once it
# closed, Termux dropped its foreground service and the low-memory killer took Termux and the service
# with it. A task keeps Termux in the foreground with no session open (measured on the A71,
# 2026-10-12: "0 sessions, 1 task", still a foreground service, the service answering).
curl -fs -m 2 http://127.0.0.1:8765/health >/dev/null && exit 0
am startservice --user 0 -n com.termux/com.termux.app.RunCommandService -a com.termux.RUN_COMMAND \
	--es com.termux.RUN_COMMAND_PATH "$HOME/bin/reader-service-up" \
	--ez com.termux.RUN_COMMAND_BACKGROUND true >/dev/null
