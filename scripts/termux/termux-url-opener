#!/data/data/com.termux/files/usr/bin/bash
# Termux runs this with the URL when something is shared to it. Downloads the video and its
# Chinese subtitles and packs them into one tar, which Reader then fetches from the reader service.
set -euo pipefail
url="$1"
# The service serves live transcripts and keeps copies; make sure it runs (ADR-0020). It also holds
# the wake lock while this job downloads and translates (issue #27). Termux keeps its foreground
# service only while a session or task runs; a service
# started in the background of a task that then ends is frozen or killed (measured on the emulator:
# it answered, the task ended, and it was gone). So this task hosts it: the final `wait` below and
# the one in the start branch outlast the job for as long as the service runs.
~/bin/reader-service-up >/dev/null 2>&1 &
service=$!

# Reader's "Start Termux" button shares this address: no browser page can open Termux directly
# (none of its activities is BROWSABLE), but a share can. Start the service, then go back.
case "$url" in http://127.0.0.1:8765/start*)
	for _ in $(seq 20); do curl -fs -m 1 http://127.0.0.1:8765/health >/dev/null && break; sleep 0.5; done
	back=$(python3 -c 'import sys, urllib.parse as u; print(u.parse_qs(u.urlsplit(sys.argv[1]).query).get("back", [""])[0])' "$url")
	case "$back" in https://emiellanckriet.github.io/language-reader/*) ;; *) back=https://emiellanckriet.github.io/language-reader/ ;; esac
	am start -a android.intent.action.VIEW -d "$back" >/dev/null 2>&1 || true
	wait "$service"
	exit 0
	;;
esac
work="$HOME/downloads/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$work"
cd "$work"

# A job that ends without a bundle says why (issue #28). Left at "packing", it showed in Reader for
# ten minutes and then vanished, and its cause closed with this window: download.log keeps yt-dlp's
# output, and the last ERROR line becomes the reason. Also waits for the service, as the end does.
finish() {
	status=$?
	if [ ! -f bundle.tar ]; then
		URL="$url" python3 - <<'PY' || true
import json, os
try:
    state = json.load(open('progress.json'))
except (OSError, ValueError):
    state = {}
lines = open('download.log', errors='replace').read().splitlines() if os.path.exists('download.log') else []
errors = [line.strip() for line in lines if line.startswith('ERROR')]
failed = {'stage': 'failed', 'reason': errors[-1] if errors else 'Nothing was downloaded.',
          'url': os.environ['URL']}
if state.get('title'):
    failed['title'] = state['title']
json.dump(failed, open('progress.json.part', 'w'), ensure_ascii=False)
os.replace('progress.json.part', 'progress.json')
PY
	fi
	wait
	exit "$status"
}
trap finish EXIT

# 480p keeps a 20-minute video around 100 MB. Subtitles in two passes (spec 012, research R1):
# every human track in any language with the video, as track.<lang>.vtt; then automatic Chinese,
# as track-auto.<lang>.vtt, only when no human Chinese arrived. --write-subs never asks for YouTube's
# machine-translated variants (zh-Hant-zh-CN, en from zh, ...), which got rate-limited (HTTP 429).
# Which track to read, and whether to ask the reader, is decided by the app (and by translate.py's
# copy of the same rule); nothing is decided here.
# --ignore-errors: a failed subtitle must not cost the video.
# --write-thumbnail: YouTube's picture for the library, as media.jpg (ffmpeg converts it).
# Through python3: the zipapp's /usr/bin/env shebang fails when Termux starts this from a share.
# progress.json while downloading, so Reader can show a bar from the moment of the share; it goes
# once the bundle exists. Written by Python, because a title can hold anything JSON must escape.
printf '{"stage": "starting"}' >progress.json
python3 "$(command -v yt-dlp)" \
	--newline --progress-template 'download:%(info.title)s	%(info.vcodec)s	%(progress._percent_str)s' \
	--js-runtimes node \
	-f 'bv*[height<=480][ext=mp4]+ba[ext=m4a]/b[height<=480]/b' \
	--merge-output-format mp4 \
	--write-subs --sub-langs 'all,-live_chat' --sub-format vtt -o 'subtitle:track.%(ext)s' \
	--sleep-subtitles 2 --ignore-errors \
	--write-info-json --no-write-playlist-metafiles --no-playlist \
	--write-thumbnail --convert-thumbnails jpg \
	-o 'media.%(ext)s' \
	"$url" 2>&1 | python3 -u -c '
import json, os, re, sys
log = open("download.log", "a")
for line in sys.stdin:
    print(line, end="", flush=True)
    fields = line.rstrip("\n").split("\t")
    if len(fields) == 3 and (percent := re.search(r"[\d.]+", fields[2])):
        part = "audio" if fields[1] == "none" else "video"
        with open("progress.json.part", "w") as file:
            json.dump({"stage": "downloading", "title": fields[0], "part": part,
                       "percent": float(percent.group())}, file, ensure_ascii=False)
        os.replace("progress.json.part", "progress.json")
    else:
        log.write(line)
        log.flush()
' || echo "yt-dlp reported an error; packing whatever arrived."
if ! ls track.zh*.vtt >/dev/null 2>&1; then
	python3 "$(command -v yt-dlp)" --js-runtimes node --skip-download --no-playlist \
		--write-auto-subs --sub-langs 'zh,zh-CN,zh-Hans,zh-SG,zh-TW,zh-Hant,zh-HK' --sub-format vtt \
		--sleep-subtitles 2 --ignore-errors -o 'subtitle:track-auto.%(ext)s' "$url" 2>&1 | tee -a download.log ||
		echo "yt-dlp could not fetch automatic Chinese subtitles."
fi
printf '{"stage": "packing"}' >progress.json

# tracks.json: each track's language, YouTube name and kind, which only the info json knows.
if ls track*.vtt >/dev/null 2>&1; then
	python3 - <<'PY'
import glob, json, os, re
info = json.load(open('media.info.json')) if os.path.exists('media.info.json') else {}
tracks = []
for path in sorted(glob.glob('track*.vtt')):
    kind, lang = re.match(r'(track(?:-auto)?)\.(.+)\.vtt$', path).groups()
    kind = 'automatic' if kind == 'track-auto' else 'human'
    listed = info.get('subtitles' if kind == 'human' else 'automatic_captions', {}).get(lang) or [{}]
    tracks.append({'file': path, 'lang': lang, 'name': listed[0].get('name') or '', 'kind': kind})
json.dump(tracks, open('tracks.json', 'w'), ensure_ascii=False)
PY
fi

# The info json is large and mostly noise; keep only what the app shows.
if [ -f media.info.json ]; then
	# job: where this bundle lives, so a restored document can find its video again (ADR-0020).
	JOB=$(basename "$work") python3 -c 'import json,os; d=json.load(open("media.info.json")); m={k:d.get(k) for k in ("id","title","uploader","duration","webpage_url","language")}; m["job"]=os.environ["JOB"]; json.dump(m,open("meta.json","w"),ensure_ascii=False)'
	rm media.info.json
fi

if ! ls media.* >/dev/null 2>&1; then
	echo "Nothing was downloaded. If YouTube changed something, try: yt-dlp -U"
	exit 1
fi

# No Chinese subtitles: Reader transcribes the video itself (spec 008, ADR-0029) and sends the
# transcript back to the reader service, which translates it then. Nothing to prepare here.

# Written aside and renamed: the reader service lists a bundle as ready the moment it exists.
part="../$(basename "$work").tar.part"
rm -f progress.json
tar cf "$part" --exclude=./download.log ./* && mv "$part" bundle.tar
echo "Packed:"; tar tvf bundle.tar
# Reader fetches the bundle from the reader service (ADR-0022); nothing is handed over here.
echo
echo "Ready: open Reader, it is at the top of the library under New from Termux."
echo "$work/bundle.tar"

# Everything below runs while the reader watches; the app picks it up from the reader service.
# English for each line of a downloaded track, but only when Reader will not ask which tracks to use
# (spec 012): then translation waits for Reader's choice, which the reader service receives. A video
# without subtitles is translated when Reader's transcript arrives (the service starts it then too).
# translate.log keeps the decision and translate.py's own output: this window closes with the job, and
# a translation that never started left no trace (2026-10-03). No "exit" line means it was killed.
if ls track*.vtt >/dev/null 2>&1; then
	choice=$(python3 ~/bin/translate.py --check-choice "$work" 2>>translate.log) || true
	llama=$(command -v llama-completion || true)
	echo "$(date '+%F %T') choice=[$choice] llama=[$llama]" >>translate.log
	if [ "$choice" = none ] && [ -n "$llama" ]; then
		(
			python3 ~/bin/translate.py "$work"
			echo "$(date '+%F %T') translate.py exit $?"
		) >>translate.log 2>&1 &
		echo "$(date '+%F %T') started translate.py" >>translate.log
	fi
fi
# Also waits for the service, when this job started it (see the top; if the service was
# already running, reader-service-up returned at once).
wait
