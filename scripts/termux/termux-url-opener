#!/data/data/com.termux/files/usr/bin/bash
# Termux runs this with the URL when something is shared to it. Downloads the video and its
# Chinese subtitles and packs them into one tar, which Reader then fetches from the reader service.
set -euo pipefail
url="$1"
# The service serves live transcripts and keeps copies; make sure it runs (ADR-0020). Termux keeps
# its foreground service, and with it the wake lock, only while a session or task runs; a service
# started in the background of a task that then ends is frozen or killed (measured on the emulator:
# it answered, the task ended, and it was gone). So this task hosts it: the final `wait` below and
# the one in the start branch outlast the job for as long as the service runs.
~/bin/reader-service-up >/dev/null 2>&1 &
service=$!

# Reader's "Start Termux" button shares this address: no browser page can open Termux directly
# (none of its activities is BROWSABLE), but a share can. Start the service, then go back.
case "$url" in http://127.0.0.1:8765/start*)
	for _ in $(seq 20); do curl -fs -m 1 http://127.0.0.1:8765/health >/dev/null && break; sleep 0.5; done
	back=$(python3 -c 'import sys, urllib.parse as u; print(u.parse_qs(u.urlsplit(sys.argv[1]).query).get("back", [""])[0])' "$url")
	case "$back" in https://emiellanckriet.github.io/language-reader/*) ;; *) back=https://emiellanckriet.github.io/language-reader/ ;; esac
	am start -a android.intent.action.VIEW -d "$back" >/dev/null 2>&1 || true
	wait "$service"
	exit 0
	;;
esac
work="$HOME/downloads/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$work"
cd "$work"

# 480p keeps a 20-minute video around 100 MB. Only original-language tracks: asking for YouTube's
# machine-translated variants (zh-Hant-zh-CN, ...) as well got rate-limited (HTTP 429). The app
# sees human and automatic tracks and prefers human; nothing is decided here.
# --ignore-errors: a failed subtitle must not cost the video.
# Through python3: the zipapp's /usr/bin/env shebang fails when Termux starts this from a share.
# progress.json while downloading, so Reader can show a bar from the moment of the share; it goes
# once the bundle exists. Written by Python, because a title can hold anything JSON must escape.
printf '{"stage": "starting"}' >progress.json
python3 "$(command -v yt-dlp)" \
	--newline --progress-template 'download:%(info.title)s	%(info.vcodec)s	%(progress._percent_str)s' \
	--js-runtimes node \
	-f 'bv*[height<=480][ext=mp4]+ba[ext=m4a]/b[height<=480]/b' \
	--merge-output-format mp4 \
	--write-subs --write-auto-subs --sub-langs 'zh,zh-CN,zh-Hans,zh-SG,zh-TW,zh-Hant,zh-HK' --sub-format vtt \
	--sleep-subtitles 2 --ignore-errors \
	--write-info-json --no-write-playlist-metafiles --no-playlist \
	-o 'media.%(ext)s' \
	"$url" | python3 -u -c '
import json, os, re, sys
for line in sys.stdin:
    print(line, end="", flush=True)
    fields = line.rstrip("\n").split("\t")
    if len(fields) == 3 and (percent := re.search(r"[\d.]+", fields[2])):
        part = "audio" if fields[1] == "none" else "video"
        with open("progress.json.part", "w") as file:
            json.dump({"stage": "downloading", "title": fields[0], "part": part,
                       "percent": float(percent.group())}, file, ensure_ascii=False)
        os.replace("progress.json.part", "progress.json")
' || echo "yt-dlp reported an error; packing whatever arrived."
printf '{"stage": "packing"}' >progress.json

# The info json is large and mostly noise; keep only what the app shows.
if [ -f media.info.json ]; then
	# job: where this bundle lives, so a restored document can find its video again (ADR-0020).
	JOB=$(basename "$work") python3 -c 'import json,os; d=json.load(open("media.info.json")); m={k:d.get(k) for k in ("id","title","uploader","duration","webpage_url","language")}; m["job"]=os.environ["JOB"]; json.dump(m,open("meta.json","w"),ensure_ascii=False)'
	rm media.info.json
fi

if ! ls media.* >/dev/null 2>&1; then
	echo "Nothing was downloaded. If YouTube changed something, try: yt-dlp -U"
	exit 1
fi

# No Chinese subtitles: share the video now and transcribe while it is being watched (ADR-0019).
# The app polls these two addresses and adds lines as they arrive.
transcribe=
if ! ls media.*.vtt >/dev/null 2>&1 && command -v whisper-cli >/dev/null; then
	job=$(basename "$work")
	printf '{"status":"http://127.0.0.1:8765/downloads/%s/status.json","vtt":"http://127.0.0.1:8765/downloads/%s/media.zh.vtt"}' \
		"$job" "$job" >transcribing.json
	transcribe=1
fi

# Written aside and renamed: the reader service lists a bundle as ready the moment it exists.
part="../$(basename "$work").tar.part"
rm -f progress.json
tar cf "$part" ./* && mv "$part" bundle.tar
echo "Packed:"; tar tvf bundle.tar
# Reader fetches the bundle from the reader service (ADR-0022); nothing is handed over here.
echo
echo "Ready: open Reader, it is at the top of the library under New from Termux."
echo "$work/bundle.tar"

# Everything below runs while the reader watches; the app picks it up from the reader service.
# The wake lock is Termux's only one, and the service needs it for as long as it runs, so it is taken
# and never released here: an unlock at the end of a job used to leave the service to be frozen.
command -v termux-wake-lock >/dev/null && termux-wake-lock
# English for each line, following the transcript as it grows when there is one.
command -v llama-completion >/dev/null && python3 ~/bin/translate.py "$work" &
if [ -n "$transcribe" ]; then
	python3 ~/bin/transcribe.py "$work" "$work/$(ls media.* | grep -E '\.(mp4|webm|m4a|mp3|opus)$' | head -1)"
fi
# Also waits for the service, when this job started it (see the top; if the service was
# already running, reader-service-up returned at once).
wait
