{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reader",
  "version": "0.1.0",
  "identifier": "io.github.emiellanckriet.reader",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Reader"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../static/icon-512.png"
    ]
  }
}
